#!/usr/bin/env php
<?php

declare(strict_types=1);

use Infocyph\PHPForge\Support\Cli;
use Infocyph\PHPForge\Composer\BenchmarkCommand;
use Infocyph\PHPForge\Composer\DoctorCommand;
use Infocyph\PHPForge\Composer\ListConfigCommand;
use Infocyph\PHPForge\Composer\WorkerSoakCommand;
use Symfony\Component\Console\Application;
use Symfony\Component\Console\Input\ArgvInput;

$autoloaders = [
    __DIR__ . '/../vendor/autoload.php',
    __DIR__ . '/../../../autoload.php',
];

foreach ($autoloaders as $autoloader) {
    if (is_file($autoloader)) {
        require $autoloader;

        break;
    }
}

$composerCommands = [
    'doctor',
    'list-config',
    'benchmark:validate',
    'benchmark:compare',
    'soak:worker',
];

if (in_array($argv[1] ?? null, $composerCommands, true) && !class_exists(Composer\Command\BaseCommand::class)) {
    fwrite(STDERR, sprintf(
        'Command "%s" requires the Composer command runtime; use "composer ic:%s" instead.%s',
        $argv[1],
        $argv[1],
        PHP_EOL,
    ));

    exit(2);
}

if (!class_exists(Cli::class)) {
    require __DIR__ . '/../src/Support/ArrayShape.php';
    require __DIR__ . '/../src/Support/CaptainHook.php';
    require __DIR__ . '/../src/Support/ComposerAuditor.php';
    require __DIR__ . '/../src/Support/BenchmarkResultValidator.php';
    require __DIR__ . '/../src/Support/BenchmarkResult.php';
    require __DIR__ . '/../src/Support/StableRuntimeConstraints.php';
    require __DIR__ . '/../src/Support/ProcessResult.php';
    require __DIR__ . '/../src/Support/ProcRunner.php';
    require __DIR__ . '/../src/Support/ConfigInventory.php';
    require __DIR__ . '/../src/Support/ConfigFileSelection.php';
    require __DIR__ . '/../src/Support/ActiveConfigFormatter.php';
    require __DIR__ . '/../src/Support/ActiveConfigInspector.php';
    require __DIR__ . '/../src/Support/PhpstanActiveConfig.php';
    require __DIR__ . '/../src/Support/PhpstanSarifConverter.php';
    require __DIR__ . '/../src/Support/Paths.php';
    require __DIR__ . '/../src/Support/QualitySummary.php';
    require __DIR__ . '/../src/Support/TaskDisplay.php';
    require __DIR__ . '/../src/Support/TaskSkipPolicy.php';
    require __DIR__ . '/../src/Support/ParallelRunner.php';
    require __DIR__ . '/../src/Support/Runner.php';
    require __DIR__ . '/../src/Composer/TaskCatalog.php';
    require __DIR__ . '/../src/Composer/BenchmarkCommand.php';
    require __DIR__ . '/../src/Composer/WorkerSoakCommand.php';
    require __DIR__ . '/../src/Support/Cli.php';
}

$standaloneCommand = match ($argv[1] ?? null) {
    'doctor' => new DoctorCommand(),
    'list-config' => new ListConfigCommand(),
    'benchmark:validate' => new BenchmarkCommand('validate', 'benchmark:validate'),
    'benchmark:compare' => new BenchmarkCommand('compare', 'benchmark:compare'),
    'soak:worker' => new WorkerSoakCommand('soak:worker'),
    default => null,
};

if ($standaloneCommand !== null) {
    $application = new Application('PHPForge');
    $application->setAutoExit(false);
    $application->addCommand($standaloneCommand);

    exit($application->run(new ArgvInput([
        $argv[0],
        $standaloneCommand->getName(),
        ...array_slice($argv, 2),
    ])));
}

exit((new Cli())->run($argv));
