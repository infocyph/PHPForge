{
    "name": "infocyph/phpforge",
    "description": "Reusable QA, refactoring, benchmark and release tooling for PHP projects.",
    "license": "MIT",
    "type": "composer-plugin",
    "keywords": [
        "infocyph",
        "composer-plugin",
        "quality",
        "testing",
        "static-analysis",
        "refactoring",
        "benchmark",
        "code-graph",
        "code-knowledge"
    ],
    "authors": [
        {
            "name": "infocyph",
            "email": "infocyph@gmail.com"
        },
        {
            "name": "abmmhasan",
            "email": "abmmhasan@gmail.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-filter": "*",
        "ext-simplexml": "*",
        "ext-tokenizer": "*",
        "composer-plugin-api": "^2.9",
        "alies-dev/psalm-plugin-pest": "^1.0.1",
        "brianium/paratest": "^7.29.0",
        "captainhook/captainhook": "^5.29.3",
        "deptrac/deptrac": "^4.7.2",
        "ergebnis/composer-normalize": "^2.59.0",
        "infocyph/phpprobe": "^1.3.1",
        "laravel/pint": "^1.32.3",
        "pestphp/pest": "^5.3.7",
        "pestphp/pest-plugin-drift": "^5.0.0",
        "pestphp/pest-plugin-phpstan": "^5.3.1",
        "phpbench/phpbench": "^1.7.1",
        "phpstan/phpstan": "^2.3.7",
        "phpstan/phpstan-phpunit": "^2.1.3",
        "psalm/plugin-phpunit": "^1.3.6",
        "rector/rector": "^2.9.2",
        "squizlabs/php_codesniffer": "^4.0.4",
        "symfony/console": "^8.1.12",
        "symfony/polyfill-php85": "^1.44.0",
        "symfony/process": "^8.1.12",
        "tomasvotruba/cognitive-complexity": "^1.3.0",
        "vimeo/psalm": "^7.21.1"
    },
    "require-dev": {
        "ext-dom": "*",
        "composer/composer": "^2.11.3",
        "symfony/yaml": "^8.1.12"
    },
    "conflict": {
        "amphp/cache": "<2.0.1",
        "amphp/dns": "<2.1.2",
        "amphp/parser": "<1.1.1",
        "amphp/process": "<2.0.3",
        "amphp/socket": "<2.3.1",
        "daverandom/libdns": "<2.1.0",
        "sebastianfeldmann/cli": "<3.4.2",
        "spatie/array-to-xml": "<3.3.0"
    },
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Infocyph\\PHPForge\\": "src/"
        },
        "files": [
            "src/Support/PhpParserCompatibility.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "PHPForge\\": "resources/PHPForge/",
            "PHP_CodeSniffer\\": "vendor/squizlabs/php_codesniffer/src/"
        },
        "files": [
            "tests/Support/FixtureData.php"
        ]
    },
    "bin": [
        "bin/phpforge"
    ],
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "infocyph/phpforge": true,
            "pestphp/pest-plugin": true
        },
        "optimize-autoloader": true,
        "process-timeout": 0,
        "sort-packages": true
    },
    "extra": {
        "class": "Infocyph\\PHPForge\\Composer\\Plugin",
        "phpforge": {
            "skipper_policy": {
                "default": "deny",
                "rules": [
                    {
                        "directive": "@psalm-taint-escape",
                        "paths": [
                            "src/Support/GeminiEndpoint.php"
                        ],
                        "reason": "Gemini model names are restricted and URL-encoded as a single segment on a fixed HTTPS origin.",
                        "security": {
                            "sanitizer": "src/Support/GeminiEndpoint.php",
                            "sha256": "efd7873deab77c5b0f3661e5082143cecca442acca6aed5029e540e838bf4603",
                            "tests": [
                                "tests/Composer/CommitMessageCommandTest.php"
                            ]
                        },
                        "taint": "url_path"
                    },
                    {
                        "directive": "@psalm-taint-escape",
                        "paths": [
                            "src/Support/KnowledgeExplainer.php"
                        ],
                        "reason": "The process launcher authorizes the Ollama origin and base path. Only HTTP(S) base URLs without credentials, queries or fragments are accepted, and redirects are disabled.",
                        "security": {
                            "sanitizer": "src/Support/KnowledgeExplainer.php",
                            "sha256": "a61d9f69ca16c1081e4e15d89ec5f5e6dce9581d8bb131e2501628d496b1f018",
                            "tests": [
                                "tests/Support/KnowledgeBaseTest.php"
                            ]
                        },
                        "taint": "file"
                    },
                    {
                        "directive": "@psalm-taint-escape",
                        "paths": [
                            "src/Support/KnowledgeExplainer.php"
                        ],
                        "reason": "The process launcher authorizes the Ollama origin and base path. Only HTTP(S) base URLs without credentials, queries or fragments are accepted, and redirects are disabled.",
                        "security": {
                            "sanitizer": "src/Support/KnowledgeExplainer.php",
                            "sha256": "a61d9f69ca16c1081e4e15d89ec5f5e6dce9581d8bb131e2501628d496b1f018",
                            "tests": [
                                "tests/Support/KnowledgeBaseTest.php"
                            ]
                        },
                        "taint": "ssrf"
                    },
                    {
                        "directive": "@psalm-taint-escape",
                        "paths": [
                            "src/Support/KnowledgeExplainer.php"
                        ],
                        "reason": "The process launcher authorizes the Ollama origin and base path. Only HTTP(S) base URLs without credentials, queries or fragments are accepted, and redirects are disabled.",
                        "security": {
                            "sanitizer": "src/Support/KnowledgeExplainer.php",
                            "sha256": "a61d9f69ca16c1081e4e15d89ec5f5e6dce9581d8bb131e2501628d496b1f018",
                            "tests": [
                                "tests/Support/KnowledgeBaseTest.php"
                            ]
                        },
                        "taint": "url_component"
                    },
                    {
                        "directive": "@psalm-taint-escape",
                        "paths": [
                            "src/Support/KnowledgeExplainer.php"
                        ],
                        "reason": "The process launcher authorizes the Ollama origin and base path. Only HTTP(S) base URLs without credentials, queries or fragments are accepted, and redirects are disabled.",
                        "security": {
                            "sanitizer": "src/Support/KnowledgeExplainer.php",
                            "sha256": "a61d9f69ca16c1081e4e15d89ec5f5e6dce9581d8bb131e2501628d496b1f018",
                            "tests": [
                                "tests/Support/KnowledgeBaseTest.php"
                            ]
                        },
                        "taint": "url_path"
                    },
                    {
                        "directive": "@psalm-taint-escape",
                        "paths": [
                            "src/Support/QualitySummary.php"
                        ],
                        "reason": "The process launcher selects a local report destination. Stream wrappers and control characters are rejected.",
                        "security": {
                            "sanitizer": "src/Support/QualitySummary.php",
                            "sha256": "84fdcb75fc717d5a01c348ae7fe6910f4536358b4d19ba5098d82231a57ad719",
                            "tests": [
                                "tests/Support/QualitySummaryTest.php"
                            ]
                        },
                        "taint": "file"
                    },
                    {
                        "directive": "@psalm-taint-escape",
                        "paths": [
                            "src/Support/SkipDirectiveEvidence.php"
                        ],
                        "reason": "Evidence resolves to a canonical local project file. Paths with traversal, wrapper syntax or symlinks are rejected.",
                        "security": {
                            "sanitizer": "src/Support/SkipDirectiveEvidence.php",
                            "sha256": "2b9f1f93f223ef94423714613642616ca0b54e1741ed383166d9ba1a0816bda1",
                            "tests": [
                                "tests/Support/SkipDirectivePolicyTest.php"
                            ]
                        },
                        "taint": "file"
                    },
                    {
                        "directive": "@psalm-taint-escape",
                        "paths": [
                            "src/Support/SkipDirectiveEvidence.php"
                        ],
                        "reason": "Evidence resolves to a canonical local project file. Paths with traversal, wrapper syntax or symlinks are rejected.",
                        "security": {
                            "sanitizer": "src/Support/SkipDirectiveEvidence.php",
                            "sha256": "2b9f1f93f223ef94423714613642616ca0b54e1741ed383166d9ba1a0816bda1",
                            "tests": [
                                "tests/Support/SkipDirectivePolicyTest.php"
                            ]
                        },
                        "taint": "url_component"
                    },
                    {
                        "directive": "@psalm-taint-escape",
                        "paths": [
                            "src/Support/SkipDirectiveEvidence.php"
                        ],
                        "reason": "Evidence resolves to a canonical local project file. Paths with traversal, wrapper syntax or symlinks are rejected.",
                        "security": {
                            "sanitizer": "src/Support/SkipDirectiveEvidence.php",
                            "sha256": "2b9f1f93f223ef94423714613642616ca0b54e1741ed383166d9ba1a0816bda1",
                            "tests": [
                                "tests/Support/SkipDirectivePolicyTest.php"
                            ]
                        },
                        "taint": "url_path"
                    }
                ]
            }
        }
    },
    "scripts": {
        "post-autoload-dump": "@php bin/install-captainhook.php",
        "ic:active-config": "@php bin/phpforge active-config",
        "ic:bench:chart": "@php bin/run-task.php bench:chart",
        "ic:bench:quick": "@php bin/run-task.php bench:quick",
        "ic:bench:run": "@ic:benchmark",
        "ic:benchmark": "@php bin/run-task.php test:bench",
        "ic:benchmark:compare": "@php bin/phpforge benchmark:compare",
        "ic:benchmark:validate": "@php bin/phpforge benchmark:validate",
        "ic:ci": "Infocyph\\PHPForge\\Composer\\CiCommand",
        "ic:commit-message": "@php bin/phpforge commit-message",
        "ic:doctor": "@php bin/phpforge doctor",
        "ic:hooks": "@php bin/run-task.php hooks",
        "ic:kb:build": "@php bin/phpforge kb:build",
        "ic:kb:query": "@php bin/phpforge kb:query",
        "ic:list-config": "@php bin/phpforge list-config",
        "ic:phpstan:sarif": "@php bin/phpforge phpstan-sarif",
        "ic:process": [
            "@composer normalize",
            "@ic:process:refactor",
            "@ic:process:psalm",
            "@ic:process:lint",
            "@ic:process:sniff"
        ],
        "ic:process:all": "@ic:process",
        "ic:process:lint": "@php bin/run-task.php process:lint",
        "ic:process:psalm": "@php bin/run-task.php process:psalm",
        "ic:process:refactor": "@php bin/run-task.php process:refactor",
        "ic:process:sniff": "@php bin/run-task.php process:sniff",
        "ic:process:sniff:fix": "@ic:process:sniff",
        "ic:release:audit": "@php bin/phpforge audit",
        "ic:release:constraints": "@php bin/phpforge release-constraints",
        "ic:release:guard": "@php bin/run-task.php release:guard",
        "ic:services:down": "@php bin/phpforge services:down",
        "ic:services:status": "@php bin/phpforge services:status",
        "ic:services:up": "@php bin/phpforge services:up",
        "ic:skipper": "@php bin/phpforge skipper",
        "ic:soak:worker": "@php bin/phpforge soak:worker",
        "ic:stage": "@php bin/phpforge stage",
        "ic:test:architecture": "@php bin/run-task.php test:architecture",
        "ic:test:bench": "@ic:benchmark",
        "ic:test:code": "@php bin/run-task.php test:code",
        "ic:test:comments": "@php bin/run-task.php test:comments",
        "ic:test:duplicates": "@php bin/run-task.php test:duplicates",
        "ic:test:lint": "@php bin/run-task.php test:lint",
        "ic:test:probe": "@php bin/run-task.php test:probe",
        "ic:test:refactor": "@php bin/run-task.php test:refactor",
        "ic:test:references": "@php bin/run-task.php test:references",
        "ic:test:security": "@php bin/run-task.php test:security",
        "ic:test:sniff": "@php bin/run-task.php test:sniff",
        "ic:test:static": "@php bin/run-task.php test:static",
        "ic:test:syntax": "@php bin/run-task.php test:syntax",
        "ic:tests": "@php bin/run-task.php tests",
        "ic:tests:all": "@ic:tests",
        "ic:tests:details": "@php bin/run-task.php tests:details",
        "ic:tests:parallel": "@ic:tests"
    }
}
