{
    "name": "infocyph/phpforge",
    "description": "Reusable QA, refactoring, benchmark and release tooling for PHP projects.",
    "license": "MIT",
    "type": "composer-plugin",
    "keywords": [
        "infocyph",
        "composer-plugin",
        "quality",
        "testing",
        "static-analysis",
        "refactoring",
        "benchmark"
    ],
    "authors": [
        {
            "name": "infocyph",
            "email": "infocyph@gmail.com"
        },
        {
            "name": "abmmhasan",
            "email": "abmmhasan@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.4",
        "composer-plugin-api": "^2.9",
        "captainhook/captainhook": "^5.29.2",
        "deptrac/deptrac": "^4.7.1",
        "ergebnis/composer-normalize": "^2.52",
        "infocyph/phpprobe": "^0.7",
        "laravel/pint": "^1.30.3",
        "pestphp/pest": "^5.0.2",
        "pestphp/pest-plugin-drift": "^5.0",
        "phpbench/phpbench": "^1.7",
        "phpdocumentor/type-resolver": "^2.0",
        "phpstan/phpstan": "^2.2.7",
        "psalm/phar": "^6.16.1",
        "rector/rector": "^2.5.9",
        "squizlabs/php_codesniffer": "^4.0.1",
        "symfony/console": "^8.1.2",
        "symfony/process": "^8.1",
        "symfony/var-dumper": "^8.1.2",
        "symfony/yaml": "^8.1.2",
        "tomasvotruba/cognitive-complexity": "^1.2.0"
    },
    "require-dev": {
        "composer/composer": "^2.10.2"
    },
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Infocyph\\PHPForge\\": "src/"
        },
        "files": [
            "src/Support/PhpParserCompatibility.php"
        ]
    },
    "bin": [
        "bin/phpforge"
    ],
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "infocyph/phpforge": true,
            "pestphp/pest-plugin": true
        },
        "optimize-autoloader": true,
        "process-timeout": 0,
        "sort-packages": true
    },
    "extra": {
        "class": "Infocyph\\PHPForge\\Composer\\Plugin"
    },
    "scripts": {
        "post-autoload-dump": "@php bin/install-captainhook.php",
        "ic:active-config": "@php bin/phpforge active-config",
        "ic:bench:chart": "@php bin/run-task.php bench:chart",
        "ic:bench:quick": "@php bin/run-task.php bench:quick",
        "ic:bench:run": "@ic:benchmark",
        "ic:benchmark": "@php bin/run-task.php test:bench",
        "ic:benchmark:compare": "@php bin/phpforge benchmark:compare",
        "ic:benchmark:validate": "@php bin/phpforge benchmark:validate",
        "ic:ci": "@php bin/phpforge ci",
        "ic:doctor": "@php bin/phpforge doctor",
        "ic:list-config": "@php bin/phpforge list-config",
        "ic:phpstan:sarif": "@php bin/phpforge phpstan-sarif",
        "ic:process": [
            "@composer normalize",
            "@ic:process:refactor",
            "@ic:process:lint",
            "@ic:process:sniff"
        ],
        "ic:process:all": "@ic:process",
        "ic:process:lint": "@php bin/run-task.php process:lint",
        "ic:process:refactor": "@php bin/run-task.php process:refactor",
        "ic:process:sniff": "@php bin/run-task.php process:sniff",
        "ic:process:sniff:fix": "@ic:process:sniff",
        "ic:release:audit": "@php bin/phpforge audit",
        "ic:release:constraints": "@php bin/phpforge release-constraints",
        "ic:release:guard": "@php bin/run-task.php release:guard",
        "ic:soak:worker": "@php bin/phpforge soak:worker",
        "ic:test:architecture": "@php bin/run-task.php test:architecture",
        "ic:test:bench": "@ic:benchmark",
        "ic:test:code": "@php bin/run-task.php test:code",
        "ic:test:comments": "@php bin/run-task.php test:comments",
        "ic:test:duplicates": "@php bin/run-task.php test:duplicates",
        "ic:test:lint": "@php bin/run-task.php test:lint",
        "ic:test:probe": "@php bin/run-task.php test:probe",
        "ic:test:refactor": "@php bin/run-task.php test:refactor",
        "ic:test:security": "@php bin/run-task.php test:security",
        "ic:test:sniff": "@php bin/run-task.php test:sniff",
        "ic:test:static": "@php bin/run-task.php test:static",
        "ic:test:syntax": "@php bin/run-task.php test:syntax",
        "ic:tests": "@php bin/run-task.php tests",
        "ic:tests:all": "@ic:tests",
        "ic:tests:details": "@php bin/run-task.php tests:details",
        "ic:tests:parallel": "@php bin/run-task.php tests:parallel"
    }
}
