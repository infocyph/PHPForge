{
  "preset": "standard",
  "reference": {
    "exclude": [
      "vendor",
      "node_modules",
      ".git",
      ".idea",
      ".vscode",
      "coverage",
      ".phpunit.cache",
      ".psalm-cache",
      "build",
      "dist",
      "tmp",
      ".tmp",
      "storage",
      "bootstrap/cache",
      "var/cache",
      "resources"
    ]
  },
  "duplicates": {
    "max_clone_groups": 100000,
    "fail_on": "error",
    "error_duplicate_percentage": 10
  },
  "commented_out_code": {
    "policy": "strict"
  }
}
