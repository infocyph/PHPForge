{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://github.com/infocyph/phpforge/blob/main/resources/benchmark-result.schema.json",
    "title": "PHPForge Representative Benchmark Result",
    "description": "A workload-neutral result contract for component, HTTP, persistent-worker, queue-worker, and custom benchmarks.",
    "type": "object",
    "required": [
        "schema_version",
        "generated_at",
        "environment",
        "workloads"
    ],
    "properties": {
        "schema_version": {
            "const": 1
        },
        "generated_at": {
            "type": "string",
            "format": "date-time"
        },
        "environment": {
            "$ref": "#/$defs/environment"
        },
        "workloads": {
            "type": "array",
            "minItems": 1,
            "items": {
                "$ref": "#/$defs/workload"
            }
        }
    },
    "additionalProperties": true,
    "$defs": {
        "nullableNonNegativeNumber": {
            "type": [
                "number",
                "null"
            ],
            "minimum": 0
        },
        "environment": {
            "type": "object",
            "required": [
                "stable",
                "fingerprint",
                "php_version",
                "php_sapi",
                "operating_system",
                "cpu_model",
                "memory_limit",
                "opcache",
                "jit",
                "xdebug",
                "extensions",
                "runner"
            ],
            "properties": {
                "stable": {
                    "type": "boolean"
                },
                "fingerprint": {
                    "type": "string",
                    "minLength": 1
                },
                "php_version": {
                    "type": "string",
                    "minLength": 1
                },
                "php_sapi": {
                    "type": "string",
                    "minLength": 1
                },
                "operating_system": {
                    "type": "string",
                    "minLength": 1
                },
                "cpu_model": {
                    "type": "string",
                    "minLength": 1
                },
                "memory_limit": {
                    "type": [
                        "string",
                        "integer"
                    ]
                },
                "opcache": {
                    "type": [
                        "boolean",
                        "string"
                    ]
                },
                "jit": {
                    "type": [
                        "boolean",
                        "string"
                    ]
                },
                "xdebug": {
                    "type": [
                        "boolean",
                        "string"
                    ]
                },
                "extensions": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "runner": {
                    "type": "string",
                    "minLength": 1
                },
                "release": {
                    "type": "string"
                }
            },
            "additionalProperties": true
        },
        "workload": {
            "type": "object",
            "required": [
                "name",
                "type",
                "metadata",
                "repetitions",
                "warmup_operations",
                "duration_seconds",
                "concurrency",
                "result"
            ],
            "properties": {
                "name": {
                    "type": "string",
                    "minLength": 1
                },
                "type": {
                    "enum": [
                        "component",
                        "http",
                        "persistent-worker",
                        "queue-worker",
                        "custom"
                    ]
                },
                "metadata": {
                    "type": "object"
                },
                "repetitions": {
                    "type": "integer",
                    "minimum": 1
                },
                "warmup_operations": {
                    "type": "integer",
                    "minimum": 0
                },
                "duration_seconds": {
                    "type": "number",
                    "minimum": 0
                },
                "concurrency": {
                    "type": "integer",
                    "minimum": 1
                },
                "result": {
                    "$ref": "#/$defs/result"
                }
            },
            "additionalProperties": true
        },
        "result": {
            "type": "object",
            "required": [
                "attempted_operations",
                "successful_operations",
                "failed_operations",
                "timeouts",
                "successful_rpm",
                "error_rate",
                "latency_ms",
                "cpu",
                "memory",
                "stability"
            ],
            "properties": {
                "attempted_operations": {
                    "type": "integer",
                    "minimum": 0
                },
                "successful_operations": {
                    "type": "integer",
                    "minimum": 0
                },
                "failed_operations": {
                    "type": "integer",
                    "minimum": 0
                },
                "timeouts": {
                    "type": "integer",
                    "minimum": 0
                },
                "successful_rpm": {
                    "type": "number",
                    "minimum": 0
                },
                "error_rate": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                },
                "latency_ms": {
                    "$ref": "#/$defs/latency"
                },
                "cpu": {
                    "$ref": "#/$defs/cpu"
                },
                "memory": {
                    "$ref": "#/$defs/memory"
                },
                "stability": {
                    "$ref": "#/$defs/stability"
                }
            },
            "additionalProperties": true
        },
        "latency": {
            "type": "object",
            "required": [
                "minimum",
                "average",
                "p50",
                "p95",
                "p99",
                "maximum"
            ],
            "properties": {
                "minimum": {
                    "$ref": "#/$defs/nullableNonNegativeNumber"
                },
                "average": {
                    "$ref": "#/$defs/nullableNonNegativeNumber"
                },
                "p50": {
                    "$ref": "#/$defs/nullableNonNegativeNumber"
                },
                "p95": {
                    "$ref": "#/$defs/nullableNonNegativeNumber"
                },
                "p99": {
                    "$ref": "#/$defs/nullableNonNegativeNumber"
                },
                "maximum": {
                    "$ref": "#/$defs/nullableNonNegativeNumber"
                }
            },
            "additionalProperties": true
        },
        "cpu": {
            "type": "object",
            "required": [
                "average_percent",
                "peak_percent"
            ],
            "properties": {
                "average_percent": {
                    "$ref": "#/$defs/nullableNonNegativeNumber"
                },
                "peak_percent": {
                    "$ref": "#/$defs/nullableNonNegativeNumber"
                }
            },
            "additionalProperties": true
        },
        "memory": {
            "type": "object",
            "required": [
                "average_mb",
                "peak_mb",
                "growth_mb"
            ],
            "properties": {
                "average_mb": {
                    "$ref": "#/$defs/nullableNonNegativeNumber"
                },
                "peak_mb": {
                    "$ref": "#/$defs/nullableNonNegativeNumber"
                },
                "growth_mb": {
                    "$ref": "#/$defs/nullableNonNegativeNumber"
                }
            },
            "additionalProperties": true
        },
        "stability": {
            "type": "object",
            "required": [
                "status",
                "spread_percent"
            ],
            "properties": {
                "status": {
                    "enum": [
                        "stable",
                        "unstable",
                        "unverified"
                    ]
                },
                "spread_percent": {
                    "type": "number",
                    "minimum": 0
                }
            },
            "additionalProperties": true
        }
    }
}
